
.venv

.env

# Artefactos generados por server_main.py (Fase 1, voice-agent) — nunca committear una clave
# privada TLS ni la base de sesiones grabadas.
apps/voice-agent/src/server.crt
apps/voice-agent/src/server.key
apps/voice-agent/src/sessions.db
# ADR-0012 — archivos de video subidos por escenario; nunca committear video real de casos.
apps/voice-agent/src/video_storage/
.pytest_cache/
__pycache__/
*.pyc

# Scripts temporales generados por dev-up.ps1 en cada corrida — no son parte del repo.
.dev-up-tmp/

# docs/designs/empaquetado-ejecutable-backend.md, Premisa 4/Distribution Plan: pesos de modelo
# descargados por scripts/fetch_models.py (varios GB, muy por encima del límite de 100MB/archivo
# de GitHub) y las carpetas de salida de PyInstaller — regenerados localmente antes de cada
# build, nunca versionados.
models/
apps/voice-agent/src/dist/
apps/voice-agent/src/build/
apps/voice-agent/src/*.spec.bak
apps/voice-agent/src/logs/