# Copiar este archivo como `.env` junto a `server_main.exe` y completar los valores vacios.
# Nunca compartir ni reutilizar el mismo SESSION_TOKEN_SECRET entre instalaciones.
# El instalador unificado copia esta plantilla a `%LOCALAPPDATA%\SIG Agent\data\.env` y
# configura SIG_AGENT_DATA_DIR al iniciar el backend; no hace falta agregar esa variable aquí.

ANTHROPIC_API_KEY=
CLAUDE_MODEL=
SESSION_TOKEN_SECRET=
SUPERVISOR_PASSPHRASE=

# Opcional: sin valor, no existe login de manager (falla cerrado; ADR-0011).
MANAGER_PASSPHRASE=

# Assets de solo lectura incluidos en `_internal/models` por PyInstaller.
WHISPER_MODEL_PATH=models\whisper
KOKORO_MODEL_DIR=models\kokoro
KOKORO_VOICE=am_michael

# El backend y el frontend actuales deben correr en la misma maquina porque el backend abre
# el microfono y los parlantes locales (frontend/BACKEND_REQUIREMENTS.md, seccion 2).
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# TLS queda prendido por default (NFR-05). No configurar DISABLE_TLS=1 en una entrega real.
TLS_CERT_PATH=server.crt
TLS_KEY_PATH=server.key
SESSIONS_DB_PATH=sessions.db
VIDEO_STORAGE_DIR=video_storage
METRICS_JUDGE_ENABLED=1
